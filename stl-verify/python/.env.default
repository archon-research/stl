LOG_LEVEL=INFO
LOG_FORMAT=json
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stl_verify
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=stl-verify-python
RISK_DEFAULT_GAP_PCT=0.15
ALLOCATION_SHARE_MAX_STALE_SECONDS=1800
# A local run tunnels into the shared staging database, so this pool competes
# with the deployed replicas for it, and the fan-out spends the ceiling at once.
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=300
DB_STATEMENT_CACHE_SIZE=0
