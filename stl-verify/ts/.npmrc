# Guard against supply chain attacks from fresh dependencies
min-release-age=7
# First-party scope: our own uikit dev tags are consumed within hours of publish,
# so a 7-day floor leaves `npm install` unable to resolve the pins at all. The
# guard is for third-party code we do not control; this scope we do.
# The flag needs npm >= 11.19, which first ships with node 26.7 — node 24
# (.node-version) bundles 11.11 and warns "Unknown project config" instead of
# honouring it, so refreshing these pins locally needs `npx npm@11.19 install`
# until the node bump. CI never resolves: it installs from the lockfile with
# `npm ci`, which does not consult the registry's publish dates at all.
min-release-age-exclude[]=@archon-research/*

# Disable script execution from packages
ignore-scripts=true
