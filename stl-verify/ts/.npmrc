# Guard against supply chain attacks from fresh dependencies
min-release-age=7

# Disable script execution from packages
ignore-scripts=true

# Hard-fail install/ci when the running npm doesn't satisfy engines.npm,
# instead of silently using whatever npm happens to be on PATH.
# Note: This will prevent Dependabot from opening PRs until GitHub supports npm 12.
# Since npm updates are manual-only (see dependabot.yml), this is acceptable.
engine-strict=true
