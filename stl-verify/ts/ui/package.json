{
  "name": "@stl-verify/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./openapi-types": "./src/generated/openapi-types.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*": "./src/*",
    "#styled-system/*": "./styled-system/*"
  },
  "scripts": {
    "prepare": "panda codegen",
    "dev": "node scripts/copy-theme-bootstrap.ts && vite",
    "build": "node scripts/copy-theme-bootstrap.ts && vite build",
    "type:check": "tsc -b",
    "format": "uikit-cli format --write \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"scripts/**/*.ts\" panda.config.ts vite.config.ts env.ts oxlint.config.ts .oxfmtrc.ts index.html",
    "format:check": "uikit-cli format --check \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"scripts/**/*.ts\" panda.config.ts vite.config.ts env.ts oxlint.config.ts .oxfmtrc.ts index.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bundle-budget": "node scripts/check-bundle-budget.ts",
    "test:explorers": "node scripts/check-explorer-urls.ts",
    "test:prime-grouping": "node scripts/check-prime-grouping.ts",
    "test:metrics-grid": "node scripts/check-metrics-grid.ts",
    "test:mock-worker": "node scripts/check-mock-worker.ts",
    "test:routes": "node scripts/check-router-urls.ts",
    "test:unindexed-chains": "node scripts/check-unindexed-chains.ts",
    "generate:openapi-types": "uikit-openapi-generate --schema ./src/generated/openapi-schema.json --output ./src/generated/openapi-types.ts && uikit-cli format --write ./src/generated/openapi-types.ts",
    "lint": "uikit-cli lint -c oxlint.config.ts --type-aware --max-warnings=0 --report-unused-disable-directives src scripts panda.config.ts vite.config.ts env.ts oxlint.config.ts .oxfmtrc.ts",
    "doctor": "uikit-cli doctor --codegen"
  },
  "dependencies": {
    "@archon-research/charting": "0.12.0-rohit-brush-band-scale-r2.1",
    "@archon-research/design-system": "0.11.0",
    "@archon-research/http-client-core": "0.11.0",
    "@archon-research/http-client-react": "0.11.0",
    "@archon-research/router-kit": "0.11.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@archon-research/oxfmt-config": "0.11.0",
    "@archon-research/oxlint-config": "0.11.0",
    "@archon-research/tsconfig": "0.11.0",
    "@archon-research/vite-config": "0.11.0",
    "@babel/core": "7.29.0",
    "@pandacss/dev": "1.12.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@stl-verify/mocks": "*",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.26",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
